# Django Settings
DEBUG=True
SECRET_KEY=django-insecure-receipt-ocr-demo-secret-key-change-in-production
ALLOWED_HOSTS=*

# OCR Configuration
# Supported options: "auto", "tesseract", "regex_fallback"
OCR_ENGINE=auto

# Optional Cloud Vision / AI API Keys (for enhanced extraction accuracy)
OPENAI_API_KEY=
GEMINI_API_KEY=

# CORS
CORS_ALLOW_ALL_ORIGINS=True
